# Phục vụ hai web đã build bên trong ảnh "web" (máy chủ Google Cloud): cổng 8080 web học tập, 8081 web quản trị.
# Chỉ trả tệp tĩnh, không HTTPS: Caddy cửa vào của máy chủ (repo backend, deploy/google-cloud/may-chu/Caddyfile) giữ HTTPS và
# chuyển /api, /files, /health sang API. Cùng quy tắc với web.config của IIS trên máy demo.
{
	admin off
	auto_https off
	persist_config off
}

(mot-trang) {
	# Chống bị nhúng vào khung của trang khác (X-Frame-Options cho trình duyệt cũ, frame-ancestors cho trình duyệt mới). Chấp nhận được vì
	# app điện thoại mở các trang /nhung/... bằng WebView ở mức trang, không đặt trong iframe; web không dùng iframe nào của chính nó
	# (quảng cáo Google tự tạo khung con bên trong trang, không bị ảnh hưởng).
	# Cố ý chỉ khai ba chỉ thị này, chưa có script-src, connect-src, img-src, frame-src...: trang nạp quảng cáo (Google Publisher Tag, AdSense,
	# Funding Choices) theo đường dẫn của Google thay đổi và gọi tiếp nhiều tên miền khác, kèm video Cloudinary, mô hình 3D, ảnh Wikimedia,
	# ô bản đồ OpenStreetMap/ArcGIS, chỉ đường OSRM và cổng VNPay; một chính sách nguồn thiếu một tên miền sẽ làm hỏng chức năng đó trong
	# im lặng. Muốn siết thêm thì trước hết chạy Content-Security-Policy-Report-Only rồi mới chuyển sang áp dụng.
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		Content-Security-Policy "frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
	}
	# Tệp trong assets/ có băm trong tên nên cache một năm; tệp thiếu trả 404 thật, không trả index.html.
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	# Còn lại (index.html, đường dẫn của ứng dụng một trang, video, phụ đề) luôn hỏi lại bản mới để nhận bản triển khai mới ngay.
	handle {
		header Cache-Control "no-cache"
		# Tệp kê khai ứng dụng web không có trong bảng kiểu nội dung có sẵn của Caddy: khai báo để trình duyệt nhận đúng kiểu.
		header /site.webmanifest Content-Type "application/manifest+json"
		try_files {path} /index.html
		file_server
	}
}

:8080 {
	root * /srv/web-hoc-tap
	import mot-trang
}

:8081 {
	root * /srv/web-quan-tri
	import mot-trang
}
