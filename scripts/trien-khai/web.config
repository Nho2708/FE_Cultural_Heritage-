<?xml version="1.0" encoding="utf-8"?>
<!--
  Cấu hình IIS dùng chung cho hai web (web quản trị, web học tập). Cần URL Rewrite và ARR (bật proxy ở cấp máy chủ).
  Luật 1: /api, /files, /health chuyển sang API ở cổng 8080 để web gọi API cùng gốc (chạy được qua đường hầm và trong mạng LAN).
  Luật 2: mọi đường dẫn không phải tệp hay thư mục có thật trả về index.html (ứng dụng một trang).
  Tiêu đề bảo mật: X-Frame-Options SAMEORIGIN và Content-Security-Policy (frame-ancestors 'self'; base-uri 'self'; object-src 'none') chống
  nhúng vào khung của trang khác. Không ảnh hưởng app điện thoại: app mở các trang /nhung/... bằng WebView ở mức trang, không đặt trong
  iframe, và web không dùng iframe nào của chính nó (khung quảng cáo Google tự tạo bên trong trang vẫn chạy bình thường).
  Cố ý chưa có script-src, connect-src, img-src, frame-src...: trang nạp quảng cáo Google (Publisher Tag, AdSense, Funding Choices) gọi tiếp
  nhiều tên miền thay đổi, kèm video Cloudinary, mô hình 3D, ô bản đồ, chỉ đường và cổng VNPay; thiếu một tên miền là hỏng chức năng
  trong im lặng. Cùng giá trị với scripts/trien-khai/Caddyfile của máy chủ Google Cloud.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Chuyen tiep sang API" stopProcessing="true">
          <match url="^(api|files|health)(/.*)?$" />
          <conditions trackAllCaptures="false">
            <!-- UNENCODED_URL giữ nguyên mã hoá phần đường dẫn và chuỗi truy vấn như trình duyệt gửi -->
            <add input="{UNENCODED_URL}" pattern="^/(.*)" />
          </conditions>
          <action type="Rewrite" url="http://localhost:8080/{C:1}" appendQueryString="false" />
        </rule>
        <rule name="Ung dung mot trang" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <!-- tệp trong assets/ bị thiếu thì trả 404 thật, không trả index.html -->
            <add input="{REQUEST_URI}" pattern="^/assets/" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

    <staticContent>
      <remove fileExtension=".glb" />
      <mimeMap fileExtension=".glb" mimeType="model/gltf-binary" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <remove fileExtension=".wasm" />
      <mimeMap fileExtension=".wasm" mimeType="application/wasm" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <!-- phụ đề và video giới thiệu (trang Giới thiệu, Dành cho nhà trường) -->
      <remove fileExtension=".vtt" />
      <mimeMap fileExtension=".vtt" mimeType="text/vtt" />
      <remove fileExtension=".webm" />
      <mimeMap fileExtension=".webm" mimeType="video/webm" />
    </staticContent>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Content-Security-Policy" value="frame-ancestors 'self'; base-uri 'self'; object-src 'none'" />
      </customHeaders>
    </httpProtocol>

    <security>
      <requestFiltering>
        <!-- tải ảnh, mô hình 3D lên qua /files và /api: nâng giới hạn mặc định 30 MB lên 100 MB -->
        <requestLimits maxAllowedContentLength="104857600" />
      </requestFiltering>
    </security>
  </system.webServer>

  <!-- index.html luôn lấy bản mới để người dùng nhận bản triển khai mới ngay -->
  <location path="index.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>

  <!-- tệp trong assets/ có băm trong tên nên cache một năm -->
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
