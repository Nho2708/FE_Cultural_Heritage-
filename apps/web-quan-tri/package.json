{
  "name": "@dsvhvn/web-quan-tri",
  "private": true,
  "version": "0.1.0",
  "description": "Web quản trị DSVHVN (tên hiển thị \"Trang quản trị\"): một ứng dụng React gộp khu giáo viên (/giao-vien), quản trị trường (/truong), quản trị hệ thống (/quan-tri), menu theo vai trò. Học sinh không đăng nhập ở đây.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint -c ../../.oxlintrc.json --deny-warnings src scripts",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "smoke:di-san": "node scripts/smoke-di-san.mjs",
    "smoke:tai-anh": "node scripts/smoke-tai-anh.mjs",
    "smoke:bai-hoc": "node scripts/smoke-bai-hoc.mjs",
    "smoke:xem-truoc": "node scripts/smoke-xem-truoc.mjs"
  },
  "dependencies": {
    "@dsvhvn/dung-chung": "0.1.0",
    "@tanstack/react-query": "^5.103.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  }
}
