# Gốc API của backend DSVHVN, gồm cả tiền tố phiên bản /api/v1. Không có dấu / ở cuối.
# Giá trị mặc định khi chạy npm run dev. Muốn đổi trên máy mình thì tạo .env.development.local.
VITE_API_BASE_URL=http://localhost:5080/api/v1
# Địa chỉ web học tập: liên kết "Mở trang khám phá di sản" và dòng nhắc học sinh đăng nhập ở đó.
VITE_LEARNING_WEB_URL=http://localhost:5174
