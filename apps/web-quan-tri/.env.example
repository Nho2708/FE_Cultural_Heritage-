# Gốc API của backend DSVHVN, gồm cả tiền tố phiên bản /api/v1. Không có dấu / ở cuối.
# Chép thành .env.local để đổi trên máy mình (tệp *.local không vào git).
VITE_API_BASE_URL=http://localhost:5080/api/v1
# Địa chỉ web học tập (không có dấu / ở cuối).
VITE_LEARNING_WEB_URL=http://localhost:5174
# Ghi chú "môi trường thử VNPay" ở màn hình Chọn gói và thanh toán. Mặc định hiện; đặt false khi dùng cổng thanh toán thật.
VITE_VNPAY_SANDBOX_NOTE=true
