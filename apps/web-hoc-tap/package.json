{
  "name": "@dsvhvn/web-hoc-tap",
  "private": true,
  "version": "0.1.0",
  "description": "Web học tập DSVHVN (tên hiển thị \"Học di sản\"): khám phá di sản công khai và khu học của học sinh (đăng nhập bằng mã học sinh), giao diện theo cấp học 1/2/3 bằng bộ token.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint -c ../../.oxlintrc.json --deny-warnings src scripts",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@dsvhvn/dung-chung": "0.1.0",
    "@tanstack/react-query": "^5.103.2",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6"
  }
}
