# Địa chỉ API của backend, gồm cả tiền tố /api/v1 (không có dấu / ở cuối). Trên điện thoại thật dùng địa chỉ IP của máy chạy backend
# trong cùng mạng Wi-Fi, không dùng localhost.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:5080/api/v1
# Địa chỉ web học tập, nơi có các trang nhúng bản đồ và 3D mở trong WebView.
EXPO_PUBLIC_WEB_BASE_URL=http://192.168.1.10:5174
# Thiết bị thử của AdMob (mã băm SDK in ra log "setTestDeviceIds", phân cách bằng dấu phẩy). Chỉ đặt khi dựng bản thử dùng đơn vị quảng cáo thật.
# EXPO_PUBLIC_ADMOB_TEST_DEVICE_IDS=
