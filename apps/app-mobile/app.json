{
  "expo": {
    "name": "Học di sản",
    "slug": "hoc-di-san",
    "scheme": "hocdisan",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Học di sản dùng vị trí của bạn để gợi ý di sản gần bạn. Vị trí chỉ để tính khoảng cách trên máy này và không được lưu."
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "userTrackingPermission": "Học di sản dùng nhận dạng quảng cáo để hiện quảng cáo phù hợp mọi lứa tuổi."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "vn.dsvhvn.hocdisan"
    },
    "android": {
      "package": "vn.dsvhvn.hocdisan"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "experiments": {
      "typedRoutes": false
    }
  }
}
