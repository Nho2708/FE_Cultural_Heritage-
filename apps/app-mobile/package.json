{
  "name": "@dsvhvn/app-mobile",
  "private": true,
  "version": "0.1.0",
  "description": "App mobile DSVHVN (tên hiển thị \"Vietnam Heritage\"): một app, hai chế độ (Khách tham quan, Học sinh), React Native + Expo. Không thuộc npm workspaces của thư mục gốc vì Expo SDK 57 cố định React 19.2.3 còn hai web dùng React 19.3; app cài phụ thuộc riêng và đọc mã dùng chung từ packages/dung-chung qua bí danh đường dẫn.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --port 8083",
    "android": "expo start --port 8083 --android",
    "ios": "expo start --port 8083 --ios",
    "typecheck": "tsc -p tsconfig.json",
    "test": "jest",
    "lint": "oxlint -c .oxlintrc.json --deny-warnings src app",
    "doctor": "npx expo-doctor",
    "export:web": "expo export --platform web"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.103.2",
    "expo": "~57.0.27",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.3",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.12",
    "expo-localization": "~57.0.2",
    "expo-location": "~57.0.20",
    "expo-router": "~58.0.18",
    "expo-secure-store": "~57.0.4",
    "expo-speech": "~57.0.3",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "i18next": "^26.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.0",
    "react-native": "0.86.3",
    "react-native-google-mobile-ads": "^17.2.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "@types/react-test-renderer": "^19.3.0",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  }
}
